# ============================================================
# IMS13 Yearbook - environment checklist
# Copy to .env and fill in. NEVER commit real secrets.
# ============================================================

# --- App ---
NODE_ENV=development
PORT=3000

# --- Session ---
# Dev uses the file store; production REQUIRES sql or redis.
SESSION_SECRET=changeme-generate-a-long-random-string
SESSION_STORE=file
SESSION_DIR=sessions

# --- Google OAuth (authentication ONLY - no Drive scopes in MVP) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Comma-separated admin allowlist (these emails may upload/manage)
ADMIN_EMAILS=you@example.com

# --- Storage driver (local = development only; r2 = production) ---
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
DATA_DIR=data

# --- Upload / body / rate limits ---
MAX_UPLOAD_BYTES=10485760
MAX_UPLOADS_PER_REQUEST=20
JSON_BODY_LIMIT=1mb
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MS=60000
UPLOAD_RATE_LIMIT_MAX=20
UPLOAD_RATE_LIMIT_WINDOW_MS=60000

# --- Metadata database (json = development only; sql = production) ---
DB_DRIVER=json
DB_URL=

# --- Cloudflare R2 (required when STORAGE_DRIVER=r2) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# --- Future: Google Drive import (separate authorization flow; NOT login scopes) ---
DRIVE_IMPORT_ENABLED=false
